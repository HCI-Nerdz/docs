flowchart TB
  log["thread.jsonl<br/>canonical log"] --> router["Harness router"]
  router --> inbox["Inbox grid<br/>chapter snapshot"]
  router --> main["Main thread<br/>coordinator"]
  router --> fork["Fork view<br/>cosmetic filter"]
  inbox --> a["summaries/A"]
  main --> b["summaries/B"]
  fork --> c["summaries/C"]
  a -. siblings read mailboxes .-> b
  b -. siblings read mailboxes .-> c
  class log,router accent
  class inbox,main,fork primary
  class a,b,c secondary

  classDef primary fill:#ffffff,stroke:#52606d,color:#172033
  classDef secondary fill:#e8edf2,stroke:#52606d,color:#172033
  classDef accent fill:#d9eee9,stroke:#0f7a73,color:#172033
  classDef success fill:#e9f7ee,stroke:#2f855a,color:#172033
  classDef warning fill:#fff4df,stroke:#b7791f,color:#172033
  classDef danger fill:#fde8e7,stroke:#c53030,color:#172033
